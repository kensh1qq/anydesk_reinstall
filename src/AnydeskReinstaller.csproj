<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AnydeskReinstaller</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- ?????? ?????? EXE (Explorer, ??????? ????, ?????? ?????) -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- ?????? single-file EXE - ??????? ????????? ?????? ??? ?????????? -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- ?????? ???????? ??????: ?????? ?? ?????? ??? (Program.CURRENT_VERSION).
         ??? ?????? ?????????? ????? ? ? version.json. -->
    <Version>1.0.4</Version>
  </PropertyGroup>

  <!-- ?? ?? ?????? ???????? ???????? - ?? ?????? ??? ??? ???? ? ???? -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ?????????? ?????????? AnyDesk, ?????? ???? ???? ????? ????? ? .csproj.
       ??? ???? ?????? ??? ????? ??????????, ? ?????? exe ??????????? ? ????????. -->
  <ItemGroup Condition="Exists('AnyDesk-6-0-8-without_advertising.exe')">
    <EmbeddedResource Include="AnyDesk-6-0-8-without_advertising.exe">
      <LogicalName>AnyDesk-6-0-8-without_advertising.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>

